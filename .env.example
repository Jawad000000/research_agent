# ==============================================================================
# DeepScan Environment Variables Configuration
# ==============================================================================

# ── Primary LLM & Search Providers (Required) ─────────────────────────────────
# Groq Cloud API Key (used by Search Agent & Critic Chain)
# Get a key at: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# Google Gemini API Key (used by Reader Agent & Writer Chain)
# Get a key at: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# Tavily AI Search API Key (used by Search Agent for live web search)
# Get a key at: https://tavily.com/
TAVILY_API_KEY="your_tavily_api_key_here"

# ── Optional Fallback & Extension Providers ───────────────────────────────────
# NVIDIA AI Foundation Endpoints API Key (optional fallback / alternative model host)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=""

# Mistral AI API Key (optional)
MISTRAL_API_KEY=""

# Hugging Face Hub User Access Token (optional)
HUGGINGFACEHUB_ACCESS_TOKEN=""
